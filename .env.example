# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose in frontend code or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Controls the staging indicator. Leave unset for local development;
# Vercel sets this to "staging" (Preview) or "production" (Production).
# Uncomment to preview the staging banner locally:
# NEXT_PUBLIC_APP_ENV=staging
